# FaaS portal configuration. Copy to /opt/faas-portal/.env or add as
# Environment= lines in the systemd unit. Defaults shown match the lab cluster.

# Harbor registry host (also used as the Kourier node IP and sslip.io base)
HARBOR_REGISTRY=192.168.1.5
# Harbor project that receives the function images
HARBOR_PROJECT=client-demo
# NodePort of the kourier service (kubectl get svc kourier -n kourier-system)
KOURIER_NODEPORT=32491
# Knative domain suffix (config-domain). Default: ${HARBOR_REGISTRY}.sslip.io
DOMAIN_SUFFIX=192.168.1.5.sslip.io
# Name of the docker-registry secret in the default namespace
IMAGE_PULL_SECRET=harbor-registry
# Where the runtime template (Dockerfile, index.py, requirements.txt) lives
TEMPLATE_DIR=/opt/faas-portal/templates
# Where per-function build contexts are written
BUILD_DIR=/opt/faas-portal/builds
# HTTP port of the portal itself
PORTAL_PORT=5000

# NOTE: the portal does not read Harbor credentials. The host must already be
# logged in: docker login 192.168.1.5 -u 'robot$client-demo+client-demo-robot'
